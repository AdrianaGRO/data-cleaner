{
  "files": {
    "input_files": [
      "data/input/messy_sample.xlsx"
    ],
    "output_file": "data/output/cleaned_data_{datetime}.xlsx"
  },
  "cleaning_options": {
    "duplicate_column": "Email",
    "keep_rule": "first",
    "date_columns": [
      "Birthday",
      "JoinDate"
    ],
    "phone_columns": [
      "Phone"
    ],
    "remove_blank_rows": true,
    "format_excel": true
  }
}